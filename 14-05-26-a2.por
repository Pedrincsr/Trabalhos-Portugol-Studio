programa
{
	
	funcao inicio()
	{
		inteiro idade 
		inteiro dias_vividos

		escreva("Digite sua idade: ")
		leia(idade)

		dias_vividos=idade*365
		escreva("dias_vividos: " + dias_vividos)
	}
}
