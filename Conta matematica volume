programa
{
	
	funcao inicio()
	{
		real comprimento
		real altura
		real largura
		real volume

		

          escreva("O comprimento da caixa é: ")
		leia(comprimento)

		escreva("A largura da caixa é: ")
		leia(largura)

		escreva("A altura da caixa é: ")
		leia(altura)



		volume = comprimento * altura * largura
		escreva ("O volume é: " + volume)

		
	}
}
